# Local API dev config. Copy to .env (gitignored), and the Makefile loads +
# exports it automatically for `make dev`, `make run`, and `make migrate`:
#
#   cp .env.example .env
#
# The DSN below matches the local Postgres from dev/docker-compose.yml (tenant
# role iron_temple / password iron_temple, plaintext local connection). Start
# that first:  ( cd dev && docker compose up -d --build --wait )
DATABASE_URL=postgres://iron_temple:iron_temple@localhost:5432/iron_temple?sslmode=disable

# Optional — the server defaults each of these when unset (see cmd/server/main.go):
#   PORT=8080
#   ENVIRONMENT=development
#   CORS_ORIGIN=            # empty allows any origin — convenient for the Vite dev server
#   REPORT_TZ=UTC           # IANA zone the Racked recap reads session clock times in
