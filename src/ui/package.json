{
  "name": "iron-temple-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "js-yaml": "^4.3.0",
      "nanoid": "^3.3.18"
    }
  },
  "scripts": {
    "dev": "pnpm generate:api && vite",
    "build": "pnpm generate:api && vite build",
    "preview": "vite preview",
    "check": "pnpm generate:api && svelte-check --tsconfig ./tsconfig.json",
    "generate:api": "openapi-ts",
    "test:unit": "pnpm generate:api && vitest run",
    "test:coverage": "pnpm generate:api && vitest run --coverage",
    "test:e2e": "pnpm generate:api && playwright test"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@hey-api/openapi-ts": "^0.99.0",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.28.0",
    "@playwright/test": "^1.49.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/svelte": "^5.2.4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^3.0.0",
    "bits-ui": "^2.16.3",
    "clsx": "^2.1.1",
    "jsdom": "^25.0.1",
    "shadcn-svelte": "^1.5.0",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.13.1",
    "canvas-confetti": "^1.9.4",
    "svelte-spa-router": "^5.1.1"
  }
}
