node_modules
dist
*.local
.env

# Vitest coverage output
/coverage/

# svelte-check --tsgo transpiles every .svelte file to disk here before handing
# the result to the Go type checker, which reads a tsconfig rather than an
# in-memory program. Rebuilt on every run; .svelte-kit would be used instead if
# this were a SvelteKit app, but it isn't.
/.svelte-check/

# Playwright
/test-results/
/playwright-report/
/playwright/.cache/

# orval-generated client (regenerated from ../api/openapi.yaml). Only the
# generated tree is ignored — src/lib/api/index.ts is the tracked barrel the app
# imports through, and orval never writes to it.
src/lib/api/generated/

# Release notes for the header's changelog panel. The release workflow writes this
# into the UI build context so the notes ship with the image, and the e2e suite
# plants a fixture copy for the length of its build. Locally the same data comes
# from git instead, so this file is always generated and never belongs in a commit.
changelog.generated.json

# orval drops a crash log here when generation fails. The dev server regenerates
# on every save of the spec, so a half-typed edit produces one routinely — they
# are noise, not artifacts worth keeping.
orval-error-*.log
